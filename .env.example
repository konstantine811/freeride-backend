MONGO_URI=mongodb://localhost:27017/freeride
PORT=4000
# Path to a Firebase service account JSON file (relative to the project root or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Alternatively, provide the service account JSON as a single-line value
# FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"...","client_email":"...","private_key":"..."}'
